# Chaves aceitas pelo provider-fake. Não são segredos reais: só funcionam contra ele.
FAKE_OPENAI_KEY=sk-fake-openai-0001
FAKE_ANTHROPIC_KEY=sk-ant-fake-0001

# Gateway (LiteLLM). Valores fixos para que a subida não tenha passo manual; só valem localmente.
# Master key: administração do gateway (criar chaves, consultar gasto). Precisa começar com sk-.
LITELLM_MASTER_KEY=sk-gateway-master-0001
# Chave virtual da app, criada automaticamente pelo gateway (gateway/keys.yaml).
GATEWAY_APP_KEY=sk-helpdesk-app-0001
# Senha do Postgres do gateway (serviço db).
GATEWAY_DB_PASSWORD=litellm-local-0001
